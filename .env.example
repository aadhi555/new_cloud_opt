# =======================================================
# SmartCloud Optimizer — Environment Configuration
# =======================================================

# Gemini AI FinOps Copilot
# Get an API key from Google AI Studio: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Service Ports
OPTIMIZER_PORT=8002
INFRA_PORT=8001
FRONTEND_PORT=3000

# -------------------------------------------------------
# Scenario 1: Local / Single-Host Docker Setup
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_INFRA_URL=http://localhost:8001
INFRA_SERVER_URL=http://localhost:8001
OPTIMIZER_SERVER_URL=http://localhost:8002

# -------------------------------------------------------
# Scenario 2: Azure 2-VM Distributed Setup
# -------------------------------------------------------
# On VM 1 (Utho Infra Server):
# OPTIMIZER_SERVER_URL=http://<VM2_AZURE_PRIVATE_IP>:8002
#
# On VM 2 (Optimizer Engine + Frontend):
# INFRA_SERVER_URL=http://<VM1_AZURE_PRIVATE_IP>:8001
# NEXT_PUBLIC_API_URL=http://<VM2_PUBLIC_IP_OR_DOMAIN>:8002
# NEXT_PUBLIC_INFRA_URL=http://<VM2_PUBLIC_IP_OR_DOMAIN>:8002/api/sim
